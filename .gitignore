# This repo IS the plugin — its root is wp-content/plugins/event-ticket-scanner,
# not a WordPress install. Do not paste WordPress core's .gitignore here: its
# `/wp-*.php` rule silently excludes this plugin's own bootstrap file.

# Dependencies (committed builds are shipped from a release branch, not here)
/vendor/
/node_modules/

# Build output
/build/
/dist/
*.zip

# Tests / tooling caches
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
/.phpcs.cache

# Local environment
/.wp-env.override.json
.env
.env.*
!.env.example

# Logs
*.log

# Editors and OS
/.idea/
/.vscode/
*.sublime-*
.DS_Store
Thumbs.db
